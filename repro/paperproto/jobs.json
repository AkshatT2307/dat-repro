[
 {
  "id": "prep_sa",
  "cmd": [
   "bash",
   "-c",
   "until grep -q DONE data/seis_raw/download.log && [ -s data/seis_raw/salt/Salt_Model_3D.tar.gz ]; do sleep 30; done; .venv/bin/python paperproto/prepare_seismic.py sa && touch data/seis/.done_prep_sa"
  ],
  "done_file": "data/seis/.done_prep_sa",
  "prio": 5,
  "deps": [],
  "env": {}
 },
 {
  "id": "prep_fixed",
  "cmd": [
   "bash",
   "-c",
   ".venv/bin/python paperproto/prepare_seismic.py fixed:sa:sg:0 fixed:sa:sb:0 && touch data/seis/.done_prep_fixed"
  ],
  "done_file": "data/seis/.done_prep_fixed",
  "prio": 5,
  "deps": [
   "prep_sa"
  ],
  "env": {}
 },
 {
  "id": "prep_f3",
  "cmd": [
   "bash",
   "-c",
   "until grep -q DONE data/seis_raw/download.log && [ -s data/seis_raw/f3/data.zip ]; do sleep 30; done; .venv/bin/python paperproto/prepare_seismic.py f3 fixed:f3:sg:0 && touch data/seis/.done_prep_f3"
  ],
  "done_file": "data/seis/.done_prep_f3",
  "prio": 5,
  "deps": [],
  "env": {}
 },
 {
  "id": "prep_st",
  "cmd": [
   "bash",
   "-c",
   "until [ \"$(stat -c %s data/seis_raw/stratton/Stratton3D_32bit.sgy)\" = 443764680 ]; do sleep 30; done; .venv/bin/python paperproto/prepare_seismic.py st fixed:st:sg:0 && touch data/seis/.done_prep_st"
  ],
  "done_file": "data/seis/.done_prep_st",
  "prio": 5,
  "deps": [],
  "env": {}
 },
